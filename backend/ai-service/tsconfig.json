{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "#services/*": ["src/services/*"],
      "#controllers/*": ["src/controllers/*"],
      "#config/*": ["src/config/*"],
      "#db/*": ["src/db/*"],
      "#models/*": ["src/models/*"],
      "#routes/*": ["src/routes/*"],
      "#llm/*": ["src/llm/*"],
      "#validators/*": ["src/validators/*"]
    }
  },
  "include": ["src"]
}
